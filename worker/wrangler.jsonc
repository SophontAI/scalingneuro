{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "scaling-neuro-ingest",
  "main": "src/index.ts",
  "compatibility_date": "2026-07-12",
  "workers_dev": false,
  "vars": {
    "R2_ACCOUNT_ID": "d367d26c39a5adf066cf2612d594f2c9",
    "R2_PARENT_ACCESS_KEY_ID": "81ce2e55db1b944d2d8ef7e6d0fd6268",
    "R2_BUCKET_NAME": "scaling-neuro",
    "CLUSTER_LAUNCH_URL": "https://cluster-launch.scalingneuro.com/v1/launch",
    "CREDENTIAL_TTL_SECONDS": "900",
    "UPLOAD_TTL_SECONDS": "604800"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "scaling-neuro-control",
      "database_id": "3e03060f-c64e-4c26-8397-9a8439ffcb30",
      "migrations_dir": "migrations"
    }
  ],
  "r2_buckets": [
    {
      "binding": "ARCHIVE",
      "bucket_name": "scaling-neuro"
    }
  ],
  "observability": {
    "enabled": true,
    "logs": {
      "enabled": true,
      "head_sampling_rate": 1
    }
  }
}
