{
  "name": "@scaling-neuro/ingest-worker",
  "version": "0.2.5",
  "private": true,
  "type": "module",
  "scripts": {
    "check": "npm run typecheck && npm test",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "build:pages": "esbuild src/pages.ts --bundle --format=esm --platform=browser --target=es2022 --outfile=../dist/_worker.js",
    "dev": "wrangler dev",
    "db:migrate:local": "wrangler d1 migrations apply scaling-neuro-control --local",
    "db:migrate:remote": "wrangler d1 migrations apply scaling-neuro-control --remote",
    "seed:local": "node scripts/seed-local.mjs",
    "admin": "node scripts/admin.mjs"
  },
  "devDependencies": {
    "@cloudflare/vitest-pool-workers": "0.18.4",
    "@cloudflare/workers-types": "5.20260712.1",
    "@types/node": "26.1.1",
    "esbuild": "0.28.1",
    "typescript": "7.0.2",
    "vitest": "4.1.10",
    "wrangler": "4.110.0"
  },
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "ajv": "8.20.0"
  }
}
