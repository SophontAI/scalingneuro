{
  "name": "@scaling-neuro/ingest-worker",
  "version": "0.5.0",
  "private": true,
  "type": "module",
  "scripts": {
    "check": "npm run typecheck && npm test",
    "types": "wrangler types src/worker-configuration.d.ts --env-interface ConfiguredEnv --include-runtime=false --strict-vars=false --check",
    "typecheck": "npm run types && tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "build:pages": "esbuild src/pages.ts --bundle --format=esm --platform=browser --target=es2022 --outfile=../dist/_worker.js",
    "dev": "wrangler dev",
    "db:migrate:local": "wrangler d1 migrations apply scaling-neuro-control --local",
    "db:migrate:remote": "wrangler d1 migrations apply scaling-neuro-control --remote"
  },
  "devDependencies": {
    "@cloudflare/vitest-pool-workers": "0.18.7",
    "@cloudflare/workers-types": "5.20260723.1",
    "@types/node": "26.1.1",
    "esbuild": "0.28.1",
    "typescript": "7.0.2",
    "vitest": "4.1.10",
    "wrangler": "4.113.0"
  },
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "ajv": "8.20.0"
  }
}
