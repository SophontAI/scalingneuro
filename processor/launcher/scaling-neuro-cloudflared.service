[Unit]
Description=Cloudflare Tunnel for Scaling Neuro cluster launch events
After=network-online.target scaling-neuro-cluster-launcher.service
Wants=network-online.target
Requires=scaling-neuro-cluster-launcher.service

[Service]
Type=simple
User=paul
UMask=0077
ExecStart=/usr/local/bin/cloudflared tunnel --no-autoupdate run --token-file /data/paul/scaling-neuro/secrets/cluster-launch-tunnel-token
Restart=on-failure
RestartSec=5
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX

[Install]
WantedBy=multi-user.target
