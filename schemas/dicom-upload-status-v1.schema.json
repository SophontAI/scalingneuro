{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://scalingneuro.com/schemas/dicom-upload-status-v1.schema.json",
  "title": "Scaling Neuro functional EPI receipt status v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["upload_id", "status", "format", "series_count"],
  "properties": {
    "upload_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "status": {
      "enum": [
        "created",
        "uploading",
        "checkpointed",
        "committed",
        "already_received",
        "expired",
        "withdrawn"
      ]
    },
    "format": { "const": "dicom-series-v1" },
    "object_prefix": { "type": "string", "maxLength": 1024 },
    "series_count": { "const": 1 },
    "total_bytes": {
      "type": "integer",
      "minimum": 32,
      "maximum": 68719476736
    },
    "consent_policy_version": { "const": "open-epi-4.0.0" },
    "data_license": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "url", "granted_at"],
      "properties": {
        "id": { "const": "CC0-1.0" },
        "url": {
          "const": "https://creativecommons.org/publicdomain/zero/1.0/"
        },
        "granted_at": {
          "type": "string",
          "format": "date-time"
        }
      }
    },
    "publication": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "scheduled_at"],
      "properties": {
        "status": { "enum": ["staged", "published"] },
        "scheduled_at": { "type": "string", "format": "date-time" },
        "published_at": { "type": "string", "format": "date-time" },
        "cancellation_email": { "const": "admin@sophont.med" }
      },
      "allOf": [
        {
          "if": {
            "properties": { "status": { "const": "staged" } },
            "required": ["status"]
          },
          "then": {
            "required": ["cancellation_email"],
            "properties": { "cancellation_email": {} }
          }
        },
        {
          "if": {
            "properties": { "status": { "const": "published" } },
            "required": ["status"]
          },
          "then": {
            "required": ["published_at"],
            "properties": { "published_at": {} }
          }
        }
      ]
    },
    "deidentification": {
      "type": "object",
      "additionalProperties": false,
      "required": ["policy_id", "policy_version"],
      "properties": {
        "policy_id": {
          "const": "scaling-neuro.dicom-deidentification"
        },
        "policy_version": { "const": "2.0.0" }
      }
    },
    "receipt": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "received_series",
        "received_bytes",
        "total_series",
        "total_bytes"
      ],
      "properties": {
        "received_series": {
          "type": "integer",
          "minimum": 0,
          "maximum": 1
        },
        "received_bytes": { "type": "integer", "minimum": 0 },
        "total_series": { "const": 1 },
        "total_bytes": { "type": "integer", "minimum": 32 }
      }
    },
    "already_received_series": {
      "type": "array",
      "maxItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["series_archive_id", "receipt_upload_id"],
        "properties": {
          "series_archive_id": {
            "type": "string",
            "pattern": "^[a-f0-9]{24}$"
          },
          "receipt_upload_id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128
          }
        }
      }
    },
    "received_at": { "type": "string", "format": "date-time" },
    "created_at": { "type": "string", "format": "date-time" },
    "updated_at": { "type": "string", "format": "date-time" }
  },
  "allOf": [
    {
      "if": {
        "properties": { "status": { "const": "already_received" } },
        "required": ["status"]
      },
      "then": {
        "required": ["already_received_series"],
        "properties": { "already_received_series": {} }
      },
      "else": {
        "required": [
          "object_prefix",
          "total_bytes",
          "consent_policy_version",
          "deidentification",
          "receipt",
          "created_at",
          "updated_at"
        ],
        "properties": {
          "object_prefix": {},
          "total_bytes": {},
          "consent_policy_version": {},
          "deidentification": {},
          "receipt": {},
          "created_at": {},
          "updated_at": {}
        }
      }
    },
    {
      "if": {
        "properties": { "status": { "const": "committed" } },
        "required": ["status"]
      },
      "then": {
        "required": ["publication"],
        "properties": { "publication": {} }
      }
    },
    {
      "if": {
        "properties": {
          "publication": {
            "type": "object",
            "properties": { "status": { "const": "published" } },
            "required": ["status"]
          }
        },
        "required": ["publication"]
      },
      "then": {
        "required": ["data_license"],
        "properties": { "data_license": {} }
      }
    }
  ]
}
