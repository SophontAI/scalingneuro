{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://scalingneuro.com/schemas/archive-manifest-v1.schema.json",
  "title": "Scaling Neuro immutable archive manifest v1",
  "description": "The Worker-authored completion record stored after every expected object passes byte-level checksum, sidecar-contract, and object-metadata verification.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "upload_id",
    "site_id",
    "project_id",
    "consent_policy_version",
    "archive_prefix",
    "client_version",
    "created_at",
    "committed_at",
    "bundles",
    "control_plane"
  ],
  "properties": {
    "schema_version": { "const": "scaling-neuro.archive-manifest.v1" },
    "upload_id": {
      "$ref": "https://scalingneuro.com/schemas/common-v1.schema.json#/$defs/uuid"
    },
    "site_id": {
      "$ref": "https://scalingneuro.com/schemas/common-v1.schema.json#/$defs/uuid"
    },
    "project_id": {
      "$ref": "https://scalingneuro.com/schemas/common-v1.schema.json#/$defs/uuid"
    },
    "consent_policy_version": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9.+_-]*$"
    },
    "archive_prefix": {
      "type": "string",
      "minLength": 1,
      "maxLength": 512,
      "pattern": "^(?!/)(?!.*\\.\\.)[A-Za-z0-9._~/-]+/$"
    },
    "client_version": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9.+_-]*$"
    },
    "created_at": {
      "$ref": "https://scalingneuro.com/schemas/common-v1.schema.json#/$defs/timestamp"
    },
    "committed_at": {
      "$ref": "https://scalingneuro.com/schemas/common-v1.schema.json#/$defs/timestamp"
    },
    "bundles": {
      "type": "array",
      "minItems": 1,
      "maxItems": 32,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "bundle_id",
          "series_id",
          "subject_id",
          "session_id",
          "protocol_group_id",
          "bundle_hash",
          "nii",
          "metadata"
        ],
        "properties": {
          "bundle_id": {
            "$ref": "https://scalingneuro.com/schemas/common-v1.schema.json#/$defs/pseudonymId"
          },
          "series_id": {
            "$ref": "https://scalingneuro.com/schemas/common-v1.schema.json#/$defs/pseudonymId"
          },
          "subject_id": {
            "$ref": "https://scalingneuro.com/schemas/common-v1.schema.json#/$defs/pseudonymId"
          },
          "session_id": {
            "$ref": "https://scalingneuro.com/schemas/common-v1.schema.json#/$defs/pseudonymId"
          },
          "protocol_group_id": {
            "$ref": "https://scalingneuro.com/schemas/common-v1.schema.json#/$defs/pseudonymId"
          },
          "bundle_hash": {
            "$ref": "https://scalingneuro.com/schemas/common-v1.schema.json#/$defs/sha256"
          },
          "nii": {
            "allOf": [
              { "$ref": "#/$defs/archiveObject" },
              {
                "type": "object",
                "required": ["uncompressed_sha256"],
                "properties": { "uncompressed_sha256": {} }
              }
            ]
          },
          "metadata": {
            "allOf": [
              { "$ref": "#/$defs/archiveObject" },
              {
                "not": {
                  "type": "object",
                  "required": ["uncompressed_sha256"],
                  "properties": { "uncompressed_sha256": {} }
                }
              }
            ]
          }
        }
      }
    },
    "control_plane": {
      "type": "object",
      "additionalProperties": false,
      "required": ["service_version"],
      "properties": {
        "service_version": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9.+_-]*$"
        }
      }
    }
  },
  "$defs": {
    "archiveObject": {
      "type": "object",
      "additionalProperties": false,
      "required": ["key", "size", "sha256", "etag"],
      "properties": {
        "key": {
          "type": "string",
          "minLength": 1,
          "maxLength": 512,
          "pattern": "^(?!/)(?!.*(?:^|/)\\.{1,2}(?:/|$))(?!.*//)[A-Za-z0-9._~/-]+$"
        },
        "size": { "type": "integer", "minimum": 2, "maximum": 5368709120 },
        "sha256": {
          "$ref": "https://scalingneuro.com/schemas/common-v1.schema.json#/$defs/sha256"
        },
        "uncompressed_sha256": {
          "$ref": "https://scalingneuro.com/schemas/common-v1.schema.json#/$defs/sha256"
        },
        "etag": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256,
          "pattern": "^[A-Za-z0-9+/=_:.-]+$"
        }
      }
    }
  }
}
