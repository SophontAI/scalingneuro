{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://scalingneuro.com/schemas/dicom-upload-init-v1.schema.json",
  "title": "Scaling Neuro deidentified DICOM series upload request v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["format", "client_version", "deidentification", "series"],
  "properties": {
    "format": { "const": "dicom-series-v1" },
    "client_version": {
      "type": "string",
      "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)(?:-[A-Za-z0-9.-]+)?(?:\\+[A-Za-z0-9.-]+)?$"
    },
    "deidentification": {
      "type": "object",
      "additionalProperties": false,
      "required": ["policy_id", "policy_version"],
      "properties": {
        "policy_id": { "const": "scaling-neuro.dicom-deidentification" },
        "policy_version": { "const": "1.0.0" }
      }
    },
    "series": {
      "type": "array",
      "minItems": 1,
      "maxItems": 8,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "series_archive_id",
          "series_id",
          "subject_id",
          "session_id",
          "protocol_group_id",
          "dicom_count",
          "archive"
        ],
        "properties": {
          "series_archive_id": { "$ref": "https://scalingneuro.com/schemas/common-v1.schema.json#/$defs/pseudonymId" },
          "series_id": { "$ref": "https://scalingneuro.com/schemas/common-v1.schema.json#/$defs/pseudonymId" },
          "subject_id": { "$ref": "https://scalingneuro.com/schemas/common-v1.schema.json#/$defs/pseudonymId" },
          "session_id": { "$ref": "https://scalingneuro.com/schemas/common-v1.schema.json#/$defs/pseudonymId" },
          "protocol_group_id": { "$ref": "https://scalingneuro.com/schemas/common-v1.schema.json#/$defs/pseudonymId" },
          "dicom_count": { "type": "integer", "minimum": 1, "maximum": 500000 },
          "archive": {
            "type": "object",
            "additionalProperties": false,
            "required": ["format", "relative_key", "size", "sha256"],
            "properties": {
              "format": { "const": "dicom-tar-zstd" },
              "relative_key": {
                "type": "string",
                "minLength": 1,
                "maxLength": 512,
                "pattern": "^[a-f0-9]{24}/dicom\\.tar\\.zst$"
              },
              "size": { "type": "integer", "minimum": 32, "maximum": 68719476736 },
              "sha256": { "$ref": "https://scalingneuro.com/schemas/common-v1.schema.json#/$defs/sha256" }
            }
          }
        }
      }
    }
  }
}
