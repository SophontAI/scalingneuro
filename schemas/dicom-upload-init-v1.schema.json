{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://scalingneuro.com/schemas/dicom-upload-init-v1.schema.json",
  "title": "Scaling Neuro deidentified DICOM series upload request v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["format", "client_version", "deidentification", "series"],
  "properties": {
    "format": { "const": "dicom-series-v1" },
    "client_version": {
      "type": "string",
      "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)(?:-[A-Za-z0-9.-]+)?(?:\\+[A-Za-z0-9.-]+)?$"
    },
    "deidentification": {
      "type": "object",
      "additionalProperties": false,
      "required": ["policy_id", "policy_version"],
      "properties": {
        "policy_id": { "const": "scaling-neuro.dicom-deidentification" },
        "policy_version": { "enum": ["1.0.0", "2.0.0"] }
      }
    },
    "series": {
      "type": "array",
      "minItems": 1,
      "maxItems": 8,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "series_archive_id",
          "series_id",
          "subject_id",
          "session_id",
          "protocol_group_id",
          "dicom_count",
          "archive"
        ],
        "properties": {
          "series_archive_id": { "$ref": "https://scalingneuro.com/schemas/common-v1.schema.json#/$defs/pseudonymId" },
          "series_id": { "$ref": "https://scalingneuro.com/schemas/common-v1.schema.json#/$defs/pseudonymId" },
          "subject_id": { "$ref": "https://scalingneuro.com/schemas/common-v1.schema.json#/$defs/pseudonymId" },
          "session_id": { "$ref": "https://scalingneuro.com/schemas/common-v1.schema.json#/$defs/pseudonymId" },
          "protocol_group_id": { "$ref": "https://scalingneuro.com/schemas/common-v1.schema.json#/$defs/pseudonymId" },
          "dicom_count": { "type": "integer", "minimum": 1, "maximum": 500000 },
          "series_kind": {
            "enum": [
              "functional_epi",
              "structural_t1w",
              "structural_t2w",
              "structural_other",
              "diffusion",
              "asl_perfusion",
              "perfusion",
              "fieldmap",
              "sbref",
              "localizer",
              "derived_mr",
              "other_mr"
            ]
          },
          "processing_route": {
            "enum": ["functional-epi-v1", "archive-verify-v1"]
          },
          "pixel_data_policy": { "const": "scanner-native-not-defaced" },
          "archive": {
            "type": "object",
            "additionalProperties": false,
            "required": ["format", "relative_key", "size", "sha256"],
            "properties": {
              "format": { "const": "dicom-tar-zstd" },
              "relative_key": {
                "type": "string",
                "minLength": 1,
                "maxLength": 512,
                "pattern": "^[a-f0-9]{24}/dicom\\.tar\\.zst$"
              },
              "size": { "type": "integer", "minimum": 32, "maximum": 68719476736 },
              "sha256": { "$ref": "https://scalingneuro.com/schemas/common-v1.schema.json#/$defs/sha256" }
            }
          }
        },
        "allOf": [
          {
            "if": {
              "type": "object",
              "properties": { "series_kind": { "const": "functional_epi" } },
              "required": ["series_kind"]
            },
            "then": {
              "properties": { "processing_route": { "const": "functional-epi-v1" } }
            },
            "else": {
              "properties": { "processing_route": { "const": "archive-verify-v1" } }
            }
          }
        ]
      }
    }
  },
  "allOf": [
    {
      "if": {
        "type": "object",
        "properties": {
          "deidentification": {
            "type": "object",
            "properties": { "policy_version": { "const": "1.0.0" } },
            "required": ["policy_version"]
          }
        },
        "required": ["deidentification"]
      },
      "then": {
        "properties": {
          "series": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "series_kind": false,
                "processing_route": false,
                "pixel_data_policy": false
              }
            }
          }
        }
      },
      "else": {
        "properties": {
          "series": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "series_kind": {},
                "processing_route": {},
                "pixel_data_policy": {}
              },
              "required": ["series_kind", "processing_route", "pixel_data_policy"]
            }
          }
        }
      }
    }
  ]
}
