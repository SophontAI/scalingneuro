{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://scalingneuro.com/schemas/local-manifest-v1.schema.json",
  "title": "neuro-sync local functional EPI manifest",
  "type": "object",
  "required": [
    "schema_version",
    "run_id",
    "client_version",
    "classifier_contract_version",
    "archive_contract_version",
    "metadata_policy",
    "created_at",
    "source_summary",
    "bundles"
  ],
  "properties": {
    "schema_version": { "type": "string" },
    "run_id": { "type": "string", "minLength": 1 },
    "site_id": { "type": "string", "minLength": 1 },
    "project_id": { "type": "string", "minLength": 1 },
    "consent_policy_version": { "const": "open-epi-2.0.0" },
    "client_version": { "type": "string" },
    "classifier_contract_version": { "type": "string" },
    "archive_contract_version": { "type": "string" },
    "metadata_policy": {
      "type": "object",
      "required": ["policy_id", "policy_version"],
      "properties": {
        "policy_id": {
          "const": "scaling-neuro.dicom-deidentification"
        },
        "policy_version": { "const": "2.0.0" }
      }
    },
    "created_at": { "type": "string", "format": "date-time" },
    "source_summary": { "type": "object" },
    "bundles": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "bundle_id",
          "series_id",
          "subject_id",
          "session_id",
          "protocol_group_id",
          "series_kind",
          "archive_route",
          "pixel_data_policy",
          "archive",
          "classification",
          "qc"
        ],
        "properties": {
          "bundle_id": {
            "type": "string",
            "pattern": "^[a-f0-9]{24}$"
          },
          "series_id": {
            "type": "string",
            "pattern": "^[a-f0-9]{24}$"
          },
          "subject_id": {
            "type": "string",
            "pattern": "^[a-f0-9]{24}$"
          },
          "session_id": {
            "type": "string",
            "pattern": "^[a-f0-9]{24}$"
          },
          "protocol_group_id": {
            "type": "string",
            "pattern": "^[a-f0-9]{24}$"
          },
          "series_kind": { "const": "functional_epi" },
          "archive_route": { "const": "functional-epi-v1" },
          "pixel_data_policy": {
            "const": "scanner-native-not-defaced"
          },
          "archive": {
            "type": "object",
            "required": [
              "relative_key",
              "size",
              "sha256",
              "format",
              "dicom_instance_count",
              "deidentification_profile",
              "deidentification_profile_version"
            ],
            "properties": {
              "relative_key": { "type": "string" },
              "local_path": { "type": "string" },
              "size": { "type": "integer", "minimum": 32 },
              "sha256": {
                "type": "string",
                "pattern": "^[a-f0-9]{64}$"
              },
              "format": { "const": "dicom-tar-zstd" },
              "dicom_instance_count": {
                "type": "integer",
                "minimum": 1
              },
              "deidentification_profile": {
                "const": "scaling-neuro.dicom-deidentification"
              },
              "deidentification_profile_version": { "const": "2.0.0" }
            }
          },
          "classification": {
            "type": "object",
            "required": ["decision", "kind"],
            "properties": {
              "decision": { "const": "accepted" },
              "kind": { "const": "functional_epi" }
            }
          },
          "qc": { "type": "object" }
        }
      }
    }
  }
}
