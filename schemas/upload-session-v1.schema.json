{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://scalingneuro.com/schemas/upload-session-v1.schema.json",
  "title": "Scaling Neuro initialized/refreshed multipart plan response v1",
  "description": "The Worker-created multipart plan. It contains no reusable R2 credential; clients request one exact, short-lived UploadPart URL at a time.",
  "type": "object",
  "additionalProperties": false,
  "required": ["upload_id", "status", "object_prefix", "multipart_objects"],
  "properties": {
    "upload_id": {
      "$ref": "https://scalingneuro.com/schemas/common-v1.schema.json#/$defs/uuid"
    },
    "status": {
      "enum": ["created", "uploading", "committed"]
    },
    "object_prefix": {
      "type": "string",
      "minLength": 1,
      "maxLength": 512,
      "pattern": "^(?!/)(?!.*\\.\\.)[A-Za-z0-9._~/-]+/$"
    },
    "multipart_objects": {
      "type": "array",
      "maxItems": 64,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["key", "upload_id", "part_size"],
        "properties": {
          "key": {
            "type": "string",
            "minLength": 1,
            "maxLength": 512,
            "pattern": "^(?!/)(?!.*\\.\\.)[A-Za-z0-9._~/-]+$"
          },
          "upload_id": {
            "description": "R2 multipart upload ID for this object, not the Scaling Neuro upload ID.",
            "type": "string",
            "minLength": 1,
            "maxLength": 1024
          },
          "part_size": {
            "type": "integer",
            "minimum": 5242880,
            "maximum": 5368709120
          }
        }
      }
    }
  },
  "allOf": [
    {
      "if": { "properties": { "status": { "type": "string", "const": "committed" } }, "required": ["status"] },
      "then": {
        "properties": {
          "multipart_objects": { "type": "array", "maxItems": 0 }
        }
      },
      "else": {
        "properties": {
          "multipart_objects": { "type": "array", "minItems": 1 }
        }
      }
    }
  ]
}
