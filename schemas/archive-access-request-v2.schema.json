{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://scalingneuro.com/schemas/archive-access-request-v2.schema.json",
  "title": "Scaling Neuro archive access form v2",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "contact_name",
    "contact_email",
    "institution_name",
    "lab_name",
    "participation_commitment",
    "data_use_agreement",
    "accepted_data_use_policy_version"
  ],
  "properties": {
    "contact_name": { "type": "string", "minLength": 2, "maxLength": 120 },
    "contact_email": {
      "type": "string",
      "format": "email",
      "maxLength": 254
    },
    "institution_name": {
      "type": "string",
      "minLength": 2,
      "maxLength": 160
    },
    "lab_name": { "type": "string", "minLength": 2, "maxLength": 160 },
    "participation_commitment": { "const": true },
    "data_use_agreement": { "const": true },
    "accepted_data_use_policy_version": {
      "const": "archive-access-1.0.0"
    }
  }
}
