{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://scalingneuro.com/schemas/upload-init-v1.schema.json",
  "title": "Scaling Neuro create-upload request v1",
  "description": "The strict request body for POST /v1/uploads. Every bundle in one request must have the same subject_id. Schema versioning is carried by the media/endpoint contract; unknown request fields are rejected.",
  "type": "object",
  "additionalProperties": false,
  "required": ["bundles", "client_version"],
  "properties": {
    "bundles": {
      "type": "array",
      "minItems": 1,
      "maxItems": 32,
      "items": { "$ref": "#/$defs/bundle" }
    },
    "client_version": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64,
      "pattern": "^(?:0|[1-9][0-9]*)\\.(?:0|[1-9][0-9]*)\\.(?:0|[1-9][0-9]*)(?:-[A-Za-z0-9.-]+)?(?:\\+[A-Za-z0-9.-]+)?$"
    }
  },
  "$defs": {
    "pseudonymId": {
      "type": "string",
      "minLength": 24,
      "maxLength": 24,
      "pattern": "^[a-f0-9]{24}$"
    },
    "relativeKey": {
      "type": "string",
      "minLength": 1,
      "maxLength": 512,
      "pattern": "^(?!/)(?!.*(?:^|/)\\.{1,2}(?:/|$))(?!.*//)[A-Za-z0-9._~-]+/[A-Za-z0-9._~-]+$"
    },
    "object": {
      "type": "object",
      "additionalProperties": false,
      "required": ["relative_key", "size", "sha256"],
      "properties": {
        "relative_key": { "$ref": "#/$defs/relativeKey" },
        "size": { "type": "integer", "minimum": 2, "maximum": 5368709120 },
        "sha256": {
          "$ref": "https://scalingneuro.com/schemas/common-v1.schema.json#/$defs/sha256"
        },
        "uncompressed_sha256": {
          "$ref": "https://scalingneuro.com/schemas/common-v1.schema.json#/$defs/sha256"
        }
      }
    },
    "bundle": {
      "type": "object",
      "additionalProperties": false,
      "required": ["bundle_id", "series_id", "subject_id", "session_id", "protocol_group_id", "nii", "metadata"],
      "properties": {
        "bundle_id": { "$ref": "#/$defs/pseudonymId" },
        "series_id": { "$ref": "#/$defs/pseudonymId" },
        "subject_id": { "$ref": "#/$defs/pseudonymId" },
        "session_id": { "$ref": "#/$defs/pseudonymId" },
        "protocol_group_id": { "$ref": "#/$defs/pseudonymId" },
        "nii": {
          "allOf": [
            { "$ref": "#/$defs/object" },
            {
              "type": "object",
              "required": ["uncompressed_sha256"],
              "properties": {
                "uncompressed_sha256": {},
                "relative_key": { "type": "string", "pattern": "\\.nii\\.gz$" },
                "size": { "type": "integer", "minimum": 352, "maximum": 5368709120 }
              }
            }
          ]
        },
        "metadata": {
          "allOf": [
            { "$ref": "#/$defs/object" },
            {
              "type": "object",
              "not": {
                "type": "object",
                "required": ["uncompressed_sha256"],
                "properties": { "uncompressed_sha256": {} }
              },
              "properties": {
                "relative_key": { "type": "string", "pattern": "\\.json$" },
                "size": { "type": "integer", "maximum": 8388608 }
              }
            }
          ]
        }
      }
    }
  }
}
