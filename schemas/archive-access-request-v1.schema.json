{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://scalingneuro.com/schemas/archive-access-request-v1.schema.json",
  "title": "Scaling Neuro archive access form v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "contact_name",
    "contact_email",
    "institution_name",
    "lab_name",
    "participation_commitment"
  ],
  "properties": {
    "contact_name": { "type": "string", "minLength": 2, "maxLength": 120 },
    "contact_email": {
      "type": "string",
      "format": "email",
      "maxLength": 254
    },
    "institution_name": {
      "type": "string",
      "minLength": 2,
      "maxLength": 160
    },
    "lab_name": { "type": "string", "minLength": 2, "maxLength": 160 },
    "participation_commitment": { "const": true }
  }
}
