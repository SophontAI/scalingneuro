{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://scalingneuro.com/schemas/upload-complete-v1.schema.json",
  "title": "Scaling Neuro complete-upload request v1",
  "description": "The strict request body for a functional EPI archive checkpoint or receipt.",
  "type": "object",
  "additionalProperties": false,
  "required": ["objects"],
  "properties": {
    "objects": {
      "type": "array",
      "minItems": 0,
      "maxItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["key", "size", "sha256", "parts"],
        "properties": {
          "key": {
            "type": "string",
            "minLength": 1,
            "maxLength": 512,
            "pattern": "^(?!/)(?!.*(?:^|/)\\.{1,2}(?:/|$))(?!.*//)[A-Za-z0-9._~/-]+$"
          },
          "size": { "type": "integer", "minimum": 32, "maximum": 68719476736 },
          "sha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "parts": {
            "type": "array",
            "minItems": 1,
            "maxItems": 10000,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["part_number", "etag"],
              "properties": {
                "part_number": { "type": "integer", "minimum": 1, "maximum": 10000 },
                "etag": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 256,
                  "pattern": "^[A-Za-z0-9+/=_:.-]+$"
                }
              }
            }
          }
        }
      }
    }
  }
}
