{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://scalingneuro.com/schemas/common-v1.schema.json",
  "title": "Scaling Neuro common contract types v1",
  "type": "object",
  "$defs": {
    "schemaVersion": {
      "const": "1.0.0"
    },
    "pseudonymId": {
      "type": "string",
      "minLength": 24,
      "maxLength": 24,
      "pattern": "^[a-f0-9]{24}$"
    },
    "uuid": {
      "type": "string",
      "format": "uuid",
      "pattern": "^[a-f0-9]{8}-[a-f0-9]{4}-[1-8][a-f0-9]{3}-[89ab][a-f0-9]{3}-[a-f0-9]{12}$"
    },
    "sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "timestamp": {
      "type": "string",
      "format": "date-time"
    },
    "safeFilename": {
      "type": "string",
      "minLength": 1,
      "maxLength": 180,
      "pattern": "^[^/\\\\\\u0000-\\u001F]+$"
    },
    "sourceSummary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "files_seen",
        "dicom_files",
        "series_found",
        "accepted",
        "held",
        "excluded"
      ],
      "properties": {
        "files_seen": { "type": "integer", "minimum": 0 },
        "dicom_files": { "type": "integer", "minimum": 0 },
        "series_found": { "type": "integer", "minimum": 0 },
        "accepted": { "type": "integer", "minimum": 0 },
        "held": { "type": "integer", "minimum": 0 },
        "excluded": { "type": "integer", "minimum": 0 }
      }
    },
    "niftiFile": {
      "type": "object",
      "additionalProperties": false,
      "required": ["filename", "size_bytes", "sha256", "uncompressed_sha256"],
      "properties": {
        "filename": { "$ref": "#/$defs/safeFilename" },
        "size_bytes": { "type": "integer", "minimum": 1, "maximum": 5368709120 },
        "sha256": { "$ref": "#/$defs/sha256" },
        "uncompressed_sha256": { "$ref": "#/$defs/sha256" }
      }
    },
    "sidecarFile": {
      "type": "object",
      "additionalProperties": false,
      "required": ["filename", "size_bytes", "sha256"],
      "properties": {
        "filename": { "$ref": "#/$defs/safeFilename" },
        "size_bytes": { "type": "integer", "minimum": 1, "maximum": 8388608 },
        "sha256": { "$ref": "#/$defs/sha256" }
      }
    },
    "classification": {
      "type": "object",
      "additionalProperties": false,
      "required": ["decision", "kind", "confidence", "evidence"],
      "properties": {
        "decision": {
          "enum": ["accepted", "held", "excluded"]
        },
        "kind": {
          "enum": [
            "functional_epi",
            "structural_t1w",
            "structural_t2w",
            "structural_other",
            "diffusion",
            "asl_perfusion",
            "perfusion",
            "asl",
            "fieldmap",
            "sbref",
            "localizer",
            "derived_mr",
            "other_mr",
            "structural",
            "derived",
            "secondary_capture",
            "unknown"
          ]
        },
        "confidence": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "evidence": {
          "type": "array",
          "minItems": 1,
          "maxItems": 64,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["code", "source", "effect"],
            "properties": {
              "code": {
                "type": "string",
                "pattern": "^[a-z][a-z0-9_.-]{2,63}$"
              },
              "source": {
                "enum": ["dicom_header", "converter_sidecar", "nifti_header", "derived"]
              },
              "effect": {
                "enum": ["supports", "limits_processing", "contradicts", "excludes"]
              }
            }
          }
        }
      }
    },
    "qualityControl": {
      "type": "object",
      "additionalProperties": false,
      "required": ["passed", "checks", "warnings"],
      "properties": {
        "passed": { "type": "boolean" },
        "checks": {
          "type": "array",
          "minItems": 1,
          "maxItems": 128,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["code", "status"],
            "properties": {
              "code": {
                "type": "string",
                "pattern": "^[a-z][a-z0-9_.-]{2,63}$"
              },
              "status": {
                "enum": ["pass", "warn", "fail"]
              }
            }
          }
        },
        "warnings": {
          "type": "array",
          "uniqueItems": true,
          "maxItems": 64,
          "items": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_.-]{2,63}(?::[1-9][0-9]{0,5})?$"
          }
        }
      }
    },
    "bundleSummary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "bundle_id",
        "subject_id",
        "session_id",
        "series_id",
        "protocol_group_id",
        "modality",
        "source_dicom_count",
        "nifti",
        "sidecar",
        "classification",
        "qc"
      ],
      "properties": {
        "bundle_id": { "$ref": "#/$defs/pseudonymId" },
        "subject_id": { "$ref": "#/$defs/pseudonymId" },
        "session_id": { "$ref": "#/$defs/pseudonymId" },
        "series_id": { "$ref": "#/$defs/pseudonymId" },
        "protocol_group_id": { "$ref": "#/$defs/pseudonymId" },
        "modality": { "const": "bold" },
        "source_dicom_count": { "type": "integer", "minimum": 1 },
        "nifti": { "$ref": "#/$defs/niftiFile" },
        "sidecar": { "$ref": "#/$defs/sidecarFile" },
        "classification": { "$ref": "#/$defs/classification" },
        "qc": { "$ref": "#/$defs/qualityControl" }
      }
    }
  }
}
