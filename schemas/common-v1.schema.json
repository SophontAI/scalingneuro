{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://scalingneuro.com/schemas/common-v1.schema.json",
  "title": "Scaling Neuro shared schema definitions",
  "$defs": {
    "uuid": {
      "type": "string",
      "pattern": "^[a-f0-9]{8}-[a-f0-9]{4}-[1-8][a-f0-9]{3}-[89ab][a-f0-9]{3}-[a-f0-9]{12}$"
    },
    "pseudonymId": {
      "type": "string",
      "pattern": "^[a-f0-9]{24}$"
    },
    "sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "timestamp": {
      "type": "string",
      "format": "date-time"
    },
    "classification": {
      "type": "object",
      "additionalProperties": false,
      "required": ["decision", "kind", "confidence", "evidence"],
      "properties": {
        "decision": { "const": "accepted" },
        "kind": { "const": "functional_epi" },
        "confidence": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "evidence": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["code", "source", "effect"],
            "properties": {
              "code": { "type": "string", "minLength": 1 },
              "source": { "const": "dicom_header" },
              "effect": {
                "enum": ["supports", "limits_classification"]
              }
            }
          }
        }
      }
    }
  }
}
