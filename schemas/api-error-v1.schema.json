{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://scalingneuro.com/schemas/api-error-v1.schema.json",
  "title": "Scaling Neuro API error response v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["error"],
  "properties": {
    "$schema": {
      "const": "https://scalingneuro.com/schemas/api-error-v1.schema.json"
    },
    "error": {
      "type": "object",
      "additionalProperties": false,
      "required": ["code", "message", "request_id"],
      "properties": {
        "code": {
          "enum": [
            "INVALID_REQUEST",
            "UNAUTHORIZED",
            "DEVICE_REVOKED",
            "CLIENT_UPDATE_REQUIRED",
            "CONSENT_POLICY_UPDATE_REQUIRED",
            "NOT_FOUND",
            "UPLOAD_NOT_WRITABLE",
            "DUPLICATE_BUNDLE",
            "OBJECT_MISSING",
            "OBJECT_MISMATCH",
            "CREDENTIALS_UNAVAILABLE",
            "STORAGE_UNAVAILABLE",
            "QUOTA_EXCEEDED",
            "CONFLICT",
            "INTERNAL"
          ]
        },
        "message": {
          "type": "string",
          "minLength": 1,
          "maxLength": 512
        },
        "request_id": {
          "type": "string",
          "minLength": 8,
          "maxLength": 128,
          "pattern": "^[A-Za-z0-9._~-]+$"
        },
        "details": {
          "type": "object",
          "additionalProperties": false,
          "minProperties": 1,
          "maxProperties": 3,
          "properties": {
            "field": {
              "type": "string",
              "minLength": 1,
              "maxLength": 64,
              "pattern": "^[a-z][a-z0-9_.-]*$"
            },
            "reason": {
              "enum": [
                "withdrawn_tombstone",
                "identity_conflict"
              ]
            },
            "consent_policy_version": {
              "type": "string",
              "minLength": 1,
              "maxLength": 64,
              "pattern": "^[A-Za-z0-9][A-Za-z0-9.+_-]*$"
            },
            "minimum_client_version": {
              "type": "string",
              "pattern": "^(?:0|[1-9][0-9]*)\\.(?:0|[1-9][0-9]*)\\.(?:0|[1-9][0-9]*)(?:-[A-Za-z0-9.-]+)?(?:\\+[A-Za-z0-9.-]+)?$"
            },
            "quota_bytes": {
              "type": "integer",
              "minimum": 1
            },
            "used_bytes": {
              "type": "integer",
              "minimum": 0
            },
            "requested_bytes": {
              "type": "integer",
              "minimum": 1
            }
          }
        }
      }
    }
  }
}
